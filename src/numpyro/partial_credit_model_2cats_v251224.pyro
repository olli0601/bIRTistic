"""
NumPyro implementation of partial_credit_model_2cats_v251224.stan

This model implements a partial credit model with two category types.
Ported from test/stan/partial_credit_model_2cats_v251224.stan

Date: 2026-05-08
"""

import jax
import jax.numpy as jnp
import numpyro
import numpyro.distributions as dist
from numpyro.contrib.control_flow import scan
from jax.scipy.special import logsumexp


def pcm_get_etas(loadings_questions, skill_thresholds, latent_factor_obs,
                 question_of_obs, cumsum_matrix):
    """
    Compute etas for partial credit model.
    
    Args:
        loadings_questions: vector of question loadings (Q,)
        skill_thresholds: matrix of skill thresholds (Q, K-1)
        latent_factor_obs: vector of latent factors for each observation (N,)
        question_of_obs: array mapping observation to question (N,) - 0-indexed
        cumsum_matrix: upper triangular matrix for cumulative sums (K-1, K-1)
    
    Returns:
        etas: matrix of dimension (N, K)
    """
    N = len(latent_factor_obs)
    Km1 = skill_thresholds.shape[1]
    K = Km1 + 1
    
    # Compute eta increments: (N, K-1)
    # eta_increments[n, k] = loading[q[n]] * (latent[n] - threshold[q[n], k])
    loadings_expanded = loadings_questions[question_of_obs]  # (N,)
    latent_expanded = jnp.tile(latent_factor_obs[:, None], (1, Km1))  # (N, K-1)
    thresholds_expanded = skill_thresholds[question_of_obs, :]  # (N, K-1)
    
    eta_increments = loadings_expanded[:, None] * (latent_expanded - thresholds_expanded)
    
    # Apply cumulative sum via matrix multiplication
    etas_cumsum = eta_increments @ cumsum_matrix  # (N, K-1)
    
    # Prepend column of zeros
    etas = jnp.concatenate([jnp.zeros((N, 1)), etas_cumsum], axis=1)  # (N, K)
    
    return etas


def categorical_logit_lpmf(y, eta):
    """
    Log probability mass function for categorical distribution with logit parameterization.
    
    Args:
        y: observed categories (N,) - 1-indexed (will convert to 0-indexed)
        eta: matrix of unnormalized log probabilities (N, K)
    
    Returns:
        log_prob: vector of log probabilities (N,)
    """
    # Convert from 1-indexed to 0-indexed
    y_idx = y - 1
    
    # Compute log probabilities via log-softmax
    log_probs = eta - logsumexp(eta, axis=1, keepdims=True)
    
    # Select the log probability for the observed category
    log_prob = log_probs[jnp.arange(len(y)), y_idx]
    
    return log_prob


def partial_credit_model_2cats(data):
    """
    NumPyro model for partial credit model with 2 category types.
    
    Args:
        data: dictionary containing:
            - U: number of units
            - P: number of predictors
            - Ncat1, Ncat2: number of observations for each category type
            - Qcat1, Qcat2: number of questions for each category type
            - Kcat1, Kcat2: number of response categories for each type
            - cat1_y, cat2_y: observed responses (1-indexed)
            - cat1_unit_of_obs, cat2_unit_of_obs: unit indices (1-indexed)
            - cat1_question_of_obs, cat2_question_of_obs: question indices (1-indexed)
            - cat1_X, cat2_X: predictor matrices
    """
    # Extract data
    U = data['U']
    P = data['P']
    
    Ncat1 = data['Ncat1']
    Qcat1 = data['Qcat1']
    Kcat1 = data['Kcat1']
    cat1_y = data['cat1_y']
    cat1_unit_of_obs = data['cat1_unit_of_obs'] - 1  # Convert to 0-indexed
    cat1_question_of_obs = data['cat1_question_of_obs'] - 1  # Convert to 0-indexed
    cat1_X = data['cat1_X']
    
    Ncat2 = data['Ncat2']
    Qcat2 = data['Qcat2']
    Kcat2 = data['Kcat2']
    cat2_y = data['cat2_y']
    cat2_unit_of_obs = data['cat2_unit_of_obs'] - 1  # Convert to 0-indexed
    cat2_question_of_obs = data['cat2_question_of_obs'] - 1  # Convert to 0-indexed
    cat2_X = data['cat2_X']
    
    # Compute s2z_sd_unit (standardization for sum-to-zero constraint)
    s2z_sd_unit = 1.0 / jnp.sqrt(1.0 - 1.0 / U)
    
    # Create cumsum matrices (upper triangular)
    cumsum_matrix_cat1 = jnp.triu(jnp.ones((Kcat1 - 1, Kcat1 - 1)))
    cumsum_matrix_cat2 = jnp.triu(jnp.ones((Kcat2 - 1, Kcat2 - 1)))
    
    # Sample parameters
    # Match Stan's `sum_to_zero_vector[U]` with `normal(0, s2z_sd_unit)` prior:
    # ZeroSumNormal samples on the U-dim sum-zero subspace using U-1 free
    # parameters internally, so the all-ones direction is not redundant.
    # Marginal sd of each element = scale * sqrt(1 - 1/U) = 1.
    latent_factor_unit = numpyro.sample(
        'latent_factor_unit',
        dist.ZeroSumNormal(scale=s2z_sd_unit, event_shape=(U,)),
    )

    latent_factor_beta = numpyro.sample('latent_factor_beta',
                                        dist.Normal(0, 1).expand([P]))

    # Skill thresholds
    cat1_skill_thresholds = numpyro.sample('cat1_skill_thresholds',
                                           dist.Normal(0, 3.5).expand([Qcat1, Kcat1 - 1]))
    cat2_skill_thresholds = numpyro.sample('cat2_skill_thresholds',
                                           dist.Normal(0, 3.5).expand([Qcat2, Kcat2 - 1]))

    # Match Stan's `vector<lower=0>[...]` + `student_t(3, 0, 1)` prior:
    # FoldedDistribution has support on [0, inf) with single mode (vs the
    # 2^(Q-1) sign-flip modes of the previous abs(StudentT) parametrization).
    # Equivalent to Stan's prior up to a normalizing constant.
    cat1_loadings_questions_m1 = numpyro.sample(
        'cat1_loadings_questions_m1',
        dist.FoldedDistribution(dist.StudentT(df=3.0, loc=0.0, scale=1.0)).expand([Qcat1 - 1]),
    )
    cat2_loadings_questions_m1 = numpyro.sample(
        'cat2_loadings_questions_m1',
        dist.FoldedDistribution(dist.StudentT(df=3.0, loc=0.0, scale=1.0)).expand([Qcat2 - 1]),
    )
    
    # Prepend 1.0 to loadings (first question has loading=1.0)
    cat1_loadings_questions = jnp.concatenate([jnp.array([1.0]), cat1_loadings_questions_m1])
    cat2_loadings_questions = jnp.concatenate([jnp.array([1.0]), cat2_loadings_questions_m1])
    
    # Compute latent factors for observations
    cat1_latent_obs = latent_factor_unit[cat1_unit_of_obs] + cat1_X @ latent_factor_beta
    cat2_latent_obs = latent_factor_unit[cat2_unit_of_obs] + cat2_X @ latent_factor_beta
    
    # Compute etas
    cat1_eta = pcm_get_etas(cat1_loadings_questions, cat1_skill_thresholds,
                            cat1_latent_obs, cat1_question_of_obs, cumsum_matrix_cat1)
    cat2_eta = pcm_get_etas(cat2_loadings_questions, cat2_skill_thresholds,
                            cat2_latent_obs, cat2_question_of_obs, cumsum_matrix_cat2)
    
    numpyro.deterministic('cat1_eta', cat1_eta)
    numpyro.deterministic('cat2_eta', cat2_eta)
    
    # Likelihood
    cat1_log_lik = categorical_logit_lpmf(cat1_y, cat1_eta)
    cat2_log_lik = categorical_logit_lpmf(cat2_y, cat2_eta)
    
    # Store individual log likelihoods
    numpyro.deterministic('cat1_log_lik', cat1_log_lik)
    numpyro.deterministic('cat2_log_lik', cat2_log_lik)
    
    # Combined log likelihood for all observations
    log_lik = jnp.concatenate([cat1_log_lik, cat2_log_lik])
    numpyro.deterministic('log_lik', log_lik)
    
    # Add to target (likelihood)
    numpyro.factor('cat1_likelihood', jnp.sum(cat1_log_lik))
    numpyro.factor('cat2_likelihood', jnp.sum(cat2_log_lik))
    
    # Posterior predictive
    cat1_probs = jax.nn.softmax(cat1_eta, axis=1)
    cat2_probs = jax.nn.softmax(cat2_eta, axis=1)
    
    numpyro.deterministic('cat1_ordered_prob_by_obs', cat1_probs)
    numpyro.deterministic('cat2_ordered_prob_by_obs', cat2_probs)


def get_log_likelihood(data, params):
    """
    Compute log likelihood for given parameters (for testing against Stan).
    
    Args:
        data: dictionary of data
        params: dictionary of parameter values
    
    Returns:
        log_lik: array of log likelihoods per observation
    """
    # Extract data
    Ncat1 = data['Ncat1']
    Qcat1 = data['Qcat1']
    Kcat1 = data['Kcat1']
    cat1_y = data['cat1_y']
    cat1_unit_of_obs = data['cat1_unit_of_obs'] - 1  # Convert to 0-indexed
    cat1_question_of_obs = data['cat1_question_of_obs'] - 1  # Convert to 0-indexed
    cat1_X = data['cat1_X']
    
    Ncat2 = data['Ncat2']
    Qcat2 = data['Qcat2']
    Kcat2 = data['Kcat2']
    cat2_y = data['cat2_y']
    cat2_unit_of_obs = data['cat2_unit_of_obs'] - 1  # Convert to 0-indexed
    cat2_question_of_obs = data['cat2_question_of_obs'] - 1  # Convert to 0-indexed
    cat2_X = data['cat2_X']
    
    # Extract parameters
    latent_factor_unit = params['latent_factor_unit']
    latent_factor_beta = params['latent_factor_beta']
    cat1_skill_thresholds = params['cat1_skill_thresholds']
    cat2_skill_thresholds = params['cat2_skill_thresholds']
    cat1_loadings_questions_m1 = params['cat1_loadings_questions_m1']
    cat2_loadings_questions_m1 = params['cat2_loadings_questions_m1']
    
    # Prepend 1.0 to loadings
    cat1_loadings_questions = jnp.concatenate([jnp.array([1.0]), cat1_loadings_questions_m1])
    cat2_loadings_questions = jnp.concatenate([jnp.array([1.0]), cat2_loadings_questions_m1])
    
    # Create cumsum matrices
    cumsum_matrix_cat1 = jnp.triu(jnp.ones((Kcat1 - 1, Kcat1 - 1)))
    cumsum_matrix_cat2 = jnp.triu(jnp.ones((Kcat2 - 1, Kcat2 - 1)))
    
    # Compute latent factors for observations
    cat1_latent_obs = latent_factor_unit[cat1_unit_of_obs] + cat1_X @ latent_factor_beta
    cat2_latent_obs = latent_factor_unit[cat2_unit_of_obs] + cat2_X @ latent_factor_beta
    
    # Compute etas
    cat1_eta = pcm_get_etas(cat1_loadings_questions, cat1_skill_thresholds,
                            cat1_latent_obs, cat1_question_of_obs, cumsum_matrix_cat1)
    cat2_eta = pcm_get_etas(cat2_loadings_questions, cat2_skill_thresholds,
                            cat2_latent_obs, cat2_question_of_obs, cumsum_matrix_cat2)
    
    # Compute log likelihoods
    cat1_log_lik = categorical_logit_lpmf(cat1_y, cat1_eta)
    cat2_log_lik = categorical_logit_lpmf(cat2_y, cat2_eta)
    
    # Combine
    log_lik = jnp.concatenate([cat1_log_lik, cat2_log_lik])
    
    return log_lik
