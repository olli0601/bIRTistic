"""
NumPyro implementation of partial_credit_model_ncats_v260413.stan.

This model supports an arbitrary number of category types (C >= 1).
Generated quantities are emitted with the same dimensions and flattened formats as Stan:
- ordered_prob_by_cat_qu_fit: vector[ordered_prob_length]
- ordered_prob_by_cat_qu_pr: vector[ordered_prob_length]
- ypred: array[N_total] int (1-indexed categories)
- log_lik: array[N_total] real
- ordinal_brier_score: array[C] vector[Q_max]
"""

import numpy as np
import jax
import jax.numpy as jnp
import numpyro
import numpyro.distributions as dist
from jax.scipy.special import logsumexp


def pcm_get_etas(loadings_questions, skill_thresholds, latent_factor_obs, question_of_obs, cumsum_matrix):
    """
    Compute PCM logits for one category type.

    Parameters
    ----------
    loadings_questions : jnp.ndarray
        Shape (Qc,).
    skill_thresholds : jnp.ndarray
        Shape (Qc, Kc-1).
    latent_factor_obs : jnp.ndarray
        Shape (Nc,).
    question_of_obs : jnp.ndarray
        Shape (Nc,), 0-indexed local question IDs.
    cumsum_matrix : jnp.ndarray
        Shape (Kc-1, Kc-1), upper triangular ones.

    Returns
    -------
    jnp.ndarray
        Eta matrix of shape (Nc, Kc).
    """
    Nc = latent_factor_obs.shape[0]
    Km1 = skill_thresholds.shape[1]

    eta_increments = (
        loadings_questions[question_of_obs][:, None]
        * (latent_factor_obs[:, None] - skill_thresholds[question_of_obs, :])
    )
    eta_cumsum = eta_increments @ cumsum_matrix
    return jnp.concatenate([jnp.zeros((Nc, 1)), eta_cumsum], axis=1)


def categorical_logit_lpmf(y, eta):
    """
    Vectorized categorical-logit log pmf.

    Parameters
    ----------
    y : jnp.ndarray
        Observed categories, 1-indexed.
    eta : jnp.ndarray
        Logits matrix, shape (N, K).

    Returns
    -------
    jnp.ndarray
        Log likelihood per observation, shape (N,).
    """
    y_idx = y - 1
    log_probs = eta - logsumexp(eta, axis=1, keepdims=True)
    return log_probs[jnp.arange(y.shape[0]), y_idx]


def _cat_ranges(cat_type):
    """Build 0-indexed [start, end) ranges per category from ordered cat_type."""
    cat_type_np = np.asarray(cat_type, dtype=int)
    if cat_type_np.ndim != 1:
        raise ValueError("cat_type must be a 1D array")
    if np.any(cat_type_np[1:] < cat_type_np[:-1]):
        raise ValueError("cat_type must be ordered by category type")

    starts = []
    ends = []
    s = 0
    for i in range(1, len(cat_type_np)):
        if cat_type_np[i] != cat_type_np[i - 1]:
            starts.append(s)
            ends.append(i)
            s = i
    starts.append(s)
    ends.append(len(cat_type_np))
    return starts, ends


def _ordered_brier_by_question(prob_obs, y_obs, q_obs_0, Qc, Kc):
    """Compute ordinal Brier score by question for one category type."""
    Km1 = Kc - 1
    out = jnp.zeros((Qc,))

    if Km1 <= 0:
        return out

    cumsum_brier = jnp.triu(jnp.ones((Kc, Km1)))
    cum_pred = prob_obs @ cumsum_brier

    y_obs_1 = y_obs.astype(jnp.int32)
    ks = jnp.arange(1, Km1 + 1)
    cum_obs = (y_obs_1[:, None] <= ks[None, :]).astype(prob_obs.dtype)

    score_obs = jnp.sum((cum_pred - cum_obs) ** 2, axis=1) / Km1

    for q in range(Qc):
        mask = q_obs_0 == q
        count = jnp.sum(mask)
        mean_q = jnp.where(count > 0, jnp.sum(jnp.where(mask, score_obs, 0.0)) / count, 0.0)
        out = out.at[q].set(mean_q)

    return out


def partial_credit_model_ncats(data, sample_ypred=True, compute_generated=True):
    """
    NumPyro partial credit model with arbitrary category types.

    Expected data keys match Stan data block names:
    C, P, U, P_pr, N, Q, K, N_total, Q_total,
    y, unit_of_obs, question_of_obs, cat_type, X, Xpr_id.

    Indexing conventions in input data follow Stan (1-indexed where applicable).
    """
    C = int(data['C'])
    P = int(data['P'])
    U = int(data['U'])
    P_pr = int(data['P_pr'])

    N = np.asarray(data['N'], dtype=int)
    Q = np.asarray(data['Q'], dtype=int)
    K = np.asarray(data['K'], dtype=int)

    N_total = int(data['N_total'])
    Q_total = int(data['Q_total'])
    Q_max = int(np.max(Q))
    K_max = int(np.max(K))

    y = jnp.asarray(data['y']).astype(jnp.int32)
    unit_of_obs_0 = jnp.asarray(data['unit_of_obs']).astype(jnp.int32) - 1
    question_of_obs_0 = jnp.asarray(data['question_of_obs']).astype(jnp.int32) - 1
    cat_type = np.asarray(data['cat_type'], dtype=int)
    X = jnp.asarray(data['X'])
    Xpr_id_0 = np.asarray(data['Xpr_id'], dtype=int) - 1

    if N_total != int(np.sum(N)):
        raise ValueError("N_total must equal sum(N)")
    if Q_total != int(np.sum(Q)):
        raise ValueError("Q_total must equal sum(Q)")

    cat_starts, cat_ends = _cat_ranges(cat_type)

    skill_offset = np.zeros((C,), dtype=int)
    ordered_prob_offset = np.zeros((C,), dtype=int)
    loadings_offset = np.zeros((C,), dtype=int)

    for c in range(1, C):
        skill_offset[c] = skill_offset[c - 1] + Q[c - 1] * (K[c - 1] - 1)
        ordered_prob_offset[c] = ordered_prob_offset[c - 1] + Q[c - 1] * K[c - 1]
        loadings_offset[c] = loadings_offset[c - 1] + (Q[c - 1] - 1)

    skill_threshold_total_length = int(np.sum(Q * (K - 1)))
    ordered_prob_length = int(np.sum(Q * K))

    s2z_sd_unit = 1.0 / jnp.sqrt(1.0 - 1.0 / U)

    # Match Stan's `sum_to_zero_vector[U]` with `normal(0, s2z_sd_unit)` prior:
    # ZeroSumNormal samples on the U-dim sum-zero subspace using U-1 free
    # parameters internally, so the all-ones direction is not redundant.
    # Marginal sd of each element = scale * sqrt(1 - 1/U) = 1.
    latent_factor_unit = numpyro.sample(
        'latent_factor_unit',
        dist.ZeroSumNormal(scale=s2z_sd_unit, event_shape=(U,)),
    )
    latent_factor_beta = numpyro.sample('latent_factor_beta', dist.Normal(0, 1).expand([P]))

    skill_thresholds = numpyro.sample(
        'skill_thresholds',
        dist.Normal(0, 3.5).expand([skill_threshold_total_length]),
    )
    # Match Stan's `vector<lower=0>[...]` + `student_t(3, 0, 1)` prior:
    # FoldedDistribution has support on [0, inf) with single mode (vs the
    # 2^(Q_total-C) sign-flip modes of the previous abs(StudentT)
    # parametrization). Equivalent to Stan's prior up to a normalizing constant.
    loadings_questions_m1 = numpyro.sample(
        'loadings_questions_m1',
        dist.FoldedDistribution(dist.StudentT(df=3.0, loc=0.0, scale=1.0)).expand([Q_total - C]),
    )

    log_lik = jnp.zeros((N_total,))
    if compute_generated:
        ordered_prob_by_cat_qu_fit = jnp.zeros((ordered_prob_length,))
        ordered_prob_by_cat_qu_pr = jnp.zeros((ordered_prob_length,))
        ordinal_brier_score = jnp.zeros((C, Q_max))

    if sample_ypred:
        logits_padded = jnp.full((N_total, K_max), -1e30)

    # Fitted quantities.
    for c in range(C):
        Nc = int(N[c])
        Qc = int(Q[c])
        Kc = int(K[c])
        Km1c = Kc - 1

        s_obs = cat_starts[c]
        e_obs = cat_ends[c]

        y_c = y[s_obs:e_obs]
        u_c = unit_of_obs_0[s_obs:e_obs]
        q_c0 = question_of_obs_0[s_obs:e_obs]

        s_skill = skill_offset[c]
        e_skill = s_skill + Qc * Km1c
        skill_c = jnp.reshape(skill_thresholds[s_skill:e_skill], (Qc, Km1c))

        s_load = loadings_offset[c]
        e_load = s_load + (Qc - 1)
        load_c = jnp.concatenate([jnp.array([1.0]), loadings_questions_m1[s_load:e_load]])

        cumsum_c = jnp.triu(jnp.ones((Km1c, Km1c)))

        latent_obs_c = latent_factor_unit[u_c] + X[s_obs:e_obs, :] @ latent_factor_beta
        eta_c = pcm_get_etas(load_c, skill_c, latent_obs_c, q_c0, cumsum_c)

        log_lik_c = categorical_logit_lpmf(y_c, eta_c)
        if sample_ypred or compute_generated:
            prob_c = jax.nn.softmax(eta_c, axis=1)

        if sample_ypred:
            logits_padded = logits_padded.at[s_obs:e_obs, :Kc].set(eta_c)
        log_lik = log_lik.at[s_obs:e_obs].set(log_lik_c)

        if compute_generated:
            by_q = jnp.zeros((Qc, Kc)).at[q_c0, :].add(prob_c)
            cnt_q = jnp.zeros((Qc,)).at[q_c0].add(1.0)

            by_q_mean = by_q / cnt_q[:, None]
            s_prob = ordered_prob_offset[c]
            ordered_prob_by_cat_qu_fit = ordered_prob_by_cat_qu_fit.at[
                s_prob:s_prob + Qc * Kc
            ].set(by_q_mean.reshape(-1))

            obs_brier = _ordered_brier_by_question(prob_c, y_c, q_c0, Qc, Kc)
            ordinal_brier_score = ordinal_brier_score.at[c, :Qc].set(obs_brier)

        numpyro.factor(f'cat_{c + 1}_likelihood', jnp.sum(log_lik_c))

    if sample_ypred:
        ypred_raw = numpyro.sample('ypred_raw', dist.Categorical(logits=logits_padded))
        ypred = numpyro.deterministic('ypred', ypred_raw + 1)

    if compute_generated:
        # Predictive quantities using Xpr only, matching Stan generated quantities behavior.
        if P_pr == P:
            ordered_prob_by_cat_qu_pr = ordered_prob_by_cat_qu_fit
        else:
            beta_pr = latent_factor_beta[jnp.asarray(Xpr_id_0)]
            X_pr = X[:, jnp.asarray(Xpr_id_0)]

            for c in range(C):
                Nc = int(N[c])
                Qc = int(Q[c])
                Kc = int(K[c])
                Km1c = Kc - 1

                s_obs = cat_starts[c]
                e_obs = cat_ends[c]
                q_c0 = question_of_obs_0[s_obs:e_obs]

                s_skill = skill_offset[c]
                e_skill = s_skill + Qc * Km1c
                skill_c = jnp.reshape(skill_thresholds[s_skill:e_skill], (Qc, Km1c))

                s_load = loadings_offset[c]
                e_load = s_load + (Qc - 1)
                load_c = jnp.concatenate([jnp.array([1.0]), loadings_questions_m1[s_load:e_load]])

                cumsum_c = jnp.triu(jnp.ones((Km1c, Km1c)))

                latent_obs_pr_c = X_pr[s_obs:e_obs, :] @ beta_pr
                eta_pr_c = pcm_get_etas(load_c, skill_c, latent_obs_pr_c, q_c0, cumsum_c)
                prob_pr_c = jax.nn.softmax(eta_pr_c, axis=1)

                by_q_pr = jnp.zeros((Qc, Kc)).at[q_c0, :].add(prob_pr_c)
                cnt_q_pr = jnp.zeros((Qc,)).at[q_c0].add(1.0)

                by_q_pr_mean = by_q_pr / cnt_q_pr[:, None]
                s_prob = ordered_prob_offset[c]
                ordered_prob_by_cat_qu_pr = ordered_prob_by_cat_qu_pr.at[
                    s_prob:s_prob + Qc * Kc
                ].set(by_q_pr_mean.reshape(-1))

        numpyro.deterministic('ordered_prob_by_cat_qu_fit', ordered_prob_by_cat_qu_fit)
        numpyro.deterministic('ordered_prob_by_cat_qu_pr', ordered_prob_by_cat_qu_pr)
        numpyro.deterministic('log_lik', log_lik)
        numpyro.deterministic('ordinal_brier_score', ordinal_brier_score)


def get_log_likelihood_ncats(data, params):
    """Compute pointwise log likelihood for a fitted parameter set."""
    C = int(data['C'])
    N = np.asarray(data['N'], dtype=int)
    Q = np.asarray(data['Q'], dtype=int)
    K = np.asarray(data['K'], dtype=int)
    N_total = int(data['N_total'])

    y = jnp.asarray(data['y']).astype(jnp.int32)
    unit_of_obs_0 = jnp.asarray(data['unit_of_obs']).astype(jnp.int32) - 1
    question_of_obs_0 = jnp.asarray(data['question_of_obs']).astype(jnp.int32) - 1
    cat_type = np.asarray(data['cat_type'], dtype=int)
    X = jnp.asarray(data['X'])

    latent_factor_unit = params['latent_factor_unit']
    latent_factor_beta = params['latent_factor_beta']
    skill_thresholds = params['skill_thresholds']
    loadings_questions_m1 = params['loadings_questions_m1']

    cat_starts, cat_ends = _cat_ranges(cat_type)

    skill_offset = np.zeros((C,), dtype=int)
    loadings_offset = np.zeros((C,), dtype=int)
    for c in range(1, C):
        skill_offset[c] = skill_offset[c - 1] + Q[c - 1] * (K[c - 1] - 1)
        loadings_offset[c] = loadings_offset[c - 1] + (Q[c - 1] - 1)

    out = jnp.zeros((N_total,))

    for c in range(C):
        Qc = int(Q[c])
        Kc = int(K[c])
        Km1c = Kc - 1

        s_obs = cat_starts[c]
        e_obs = cat_ends[c]

        y_c = y[s_obs:e_obs]
        u_c = unit_of_obs_0[s_obs:e_obs]
        q_c0 = question_of_obs_0[s_obs:e_obs]

        s_skill = skill_offset[c]
        e_skill = s_skill + Qc * Km1c
        skill_c = jnp.reshape(skill_thresholds[s_skill:e_skill], (Qc, Km1c))

        s_load = loadings_offset[c]
        e_load = s_load + (Qc - 1)
        load_c = jnp.concatenate([jnp.array([1.0]), loadings_questions_m1[s_load:e_load]])

        cumsum_c = jnp.triu(jnp.ones((Km1c, Km1c)))
        latent_obs_c = latent_factor_unit[u_c] + X[s_obs:e_obs, :] @ latent_factor_beta
        eta_c = pcm_get_etas(load_c, skill_c, latent_obs_c, q_c0, cumsum_c)

        out = out.at[s_obs:e_obs].set(categorical_logit_lpmf(y_c, eta_c))

    return out
