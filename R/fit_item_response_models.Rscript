#!/usr/bin/env Rscript

# Fit item response models to Colombia data
# This script is designed to be run as a PBS job array
#
# Usage:
#   Rscript fit_item_response_models.Rscript \
#     --json_file <path_to_json_config>
#
# The JSON configuration file should contain:
#   - runs: array of run configurations, each with:
#       * model_name: "ordered_logit", "credit_model", or "partial_credit_model"
#       * model_version: version string (e.g., "v251222")
#       * stan_file: path to Stan model file
#       * seed: random seed for reproducibility
#       * output_prefix: prefix for output files
#       * dir_out: output directory for that model
#   - data_file: path to .rda file containing preprocessed dp1 and dit objects
#   - dir_out: main output directory
#   - chains: number of MCMC chains
#   - parallel_chains: number of chains to run in parallel
#   - threads_per_chain: threads per chain
#   - iter_warmup: number of warmup iterations
#   - iter_sampling: number of sampling iterations
#   - with_core_analyses: boolean for core analyses
#   - with_additional_analyses: boolean for additional analyses
#   - show_messages: boolean for showing messages
#   - show_exceptions: boolean for showing exceptions
#
# PBS Job Array Usage:
#   The script automatically detects PBS_ARRAYID or PBS_ARRAY_INDEX
#   to determine which run configuration to execute.
#   If no PBS array index is detected, all runs will be executed sequentially.

# Parse command line arguments
library(argparse)
library(jsonlite)

parser <- ArgumentParser(description = "Fit item response models to Colombia data")
parser$add_argument(
    "--json_file",
    type = "character",
    required = TRUE,
    help = "Path to JSON file with input arguments"
)

args <- parser$parse_args()

# Read arguments from JSON file
cat("Reading arguments from JSON file:", args$json_file, "\n")
if (!file.exists(args$json_file)) {
    stop("JSON file not found: ", args$json_file)
}
json_args <- jsonlite::fromJSON(args$json_file)

# Validate that all required arguments are present
required_args <- c(
    "runs",
    "data_file",
    "dir_out",
    "chains",
    "parallel_chains",
    "iter_warmup",
    "iter_sampling",
    "with_core_analyses",
    "with_additional_analyses",
    "show_messages",
    "show_exceptions"
)
missing_args <- setdiff(required_args, names(json_args))
if (length(missing_args) > 0) {
    stop(
        "Missing required arguments in JSON file: ",
        paste(missing_args, collapse = ", "),
        "\nRequired arguments are: ",
        paste(required_args, collapse = ", ")
    )
}

# Extract configuration from JSON
runs <- json_args$runs
chains <- as.integer(json_args$chains)
parallel_chains <- as.integer(json_args$parallel_chains)
iter_warmup <- as.integer(json_args$iter_warmup)
iter_sampling <- as.integer(json_args$iter_sampling)
data_file <- json_args$data_file
dir_out <- json_args$dir_out
with_core_analyses <- as.logical(json_args$with_core_analyses)
with_additional_analyses <- as.logical(json_args$with_additional_analyses)
show_messages <- as.logical(json_args$show_messages)
show_exceptions <- as.logical(json_args$show_exceptions)

# Check for PBS array index
cat("Checking for PBS array index...\n")
pbs_array_index <- Sys.getenv("PBS_ARRAYID")
if (pbs_array_index == "") {
    pbs_array_index <- Sys.getenv("PBS_ARRAY_INDEX")
}

if (pbs_array_index != "" && !is.na(as.integer(pbs_array_index))) {
    split_idcs <- as.integer(pbs_array_index)
    cat("PBS array index detected:", split_idcs, "\n")
} else {
    split_idcs <- seq_along(runs)
    cat("No PBS array index detected. Running all splits:", paste(split_idcs, collapse = ", "), "\n")
}

# Load packages
cat("Loading packages...\n")
packages <- c(
    "data.table",
    "here",
    "ggplot2",
    "ggsci",
    "cmdstanr"
)
invisible(lapply(packages, library, character.only = TRUE))

# Source functions
source(here::here("R", "credit_model_run_analysis.R"))
source(here::here("R", "ordered_logit_model_run_analysis.R"))
source(here::here("R", "partial_credit_model_run_analysis.R"))

cat("\nConfiguration:\n")
cat(sprintf("  chains: %s\n", chains))
cat(sprintf("  parallel_chains: %s\n", parallel_chains))
cat(sprintf("  iter_warmup: %s\n", iter_warmup))
cat(sprintf("  iter_sampling: %s\n", iter_sampling))
cat(sprintf("  with_core_analyses: %s\n", with_core_analyses))
cat(sprintf("  with_additional_analyses: %s\n", with_additional_analyses))
cat(sprintf("  show_messages: %s\n", show_messages))
cat(sprintf("  show_exceptions: %s\n", show_exceptions))
cat(sprintf("  data_file: %s\n", data_file))
cat(sprintf("  dir_out: %s\n", dir_out))
cat("\n")

# Load preprocessed data
cat("Loading preprocessed data from:", data_file, "\n")
if (!file.exists(data_file)) {
    stop("Data file not found: ", data_file)
}
load(data_file)  # Loads dp1 and dit

cat("Data loaded successfully.\n")
cat("Total observations:", nrow(dp1), "\n")
cat("Number of items:", nrow(dit), "\n\n")

# Loop through selected runs based on PBS array index
for (split_idx in split_idcs) {
    cat("======================================\n")
    cat("Run", split_idx, "of", length(runs), "\n")
    cat("======================================\n")
    
    # Get run configuration
    run_config <- runs[[split_idx]]
    model_name <- run_config$model_name
    model_version <- run_config$model_version
    stan_file <- run_config$stan_file
    seed <- as.integer(run_config$seed)
    output_prefix <- run_config$output_prefix
    
    cat("Model:", model_name, "\n")
    cat("Version:", model_version, "\n")
    cat("Stan file:", stan_file, "\n")
    cat("Seed:", seed, "\n")
    cat("Output prefix:", output_prefix, "\n\n")
    
    # Check if file exists
    if (!file.exists(stan_file)) {
        cat("WARNING: Stan file not found:", stan_file, "\n")
        cat("Skipping this run.\n\n")
        next
    }
    
    # Create output directory for this seed
    seed_dir <- file.path(dir_out, paste0('seed-', seed))
    dir.create(seed_dir, recursive = TRUE, showWarnings = FALSE)
    output_file_prefix <- file.path(seed_dir, output_prefix)
    
    # Check if output file already exists
    rds_file <- paste0(output_file_prefix, "_fit_alldata_stan.rds")
    if (file.exists(rds_file) && file.info(rds_file)$size > 0) {
        cat("Output file already exists and is non-zero. Skipping this run.\n\n")
        next
    }
    
    # Set seed
    set.seed(seed)
    
    # Fit model based on model name
    cat("Fitting model...\n")
    if (model_name == "ordered_logit") {
        ordered_logit_model_run_analysis(
            dit,
            dp1,
            output_file_prefix = paste0(output_file_prefix, "_fit_alldata"),
            stan_file = stan_file,
            chains = chains,
            parallel_chains = parallel_chains,
            threads_per_chain = 1L,
            iter_warmup = iter_warmup,
            iter_sampling = iter_sampling,
            seed = seed,
            with_core_analyses = with_core_analyses,
            with_additional_analyses = with_additional_analyses,
            show_messages = show_messages,
            show_exceptions = show_exceptions
        )
    } else if (model_name == "credit_model") {
        credit_model_run_analysis(
            dit,
            dp1,
            output_file_prefix = paste0(output_file_prefix, "_fit_alldata"),
            stan_file = stan_file,
            chains = chains,
            parallel_chains = parallel_chains,
            threads_per_chain = 1L,
            iter_warmup = iter_warmup,
            iter_sampling = iter_sampling,
            seed = seed,
            with_core_analyses = with_core_analyses,
            with_additional_analyses = with_additional_analyses,
            show_messages = show_messages,
            show_exceptions = show_exceptions
        )
    } else if (model_name == "partial_credit_model") {
        partial_credit_model_run_analysis(
            dit,
            dp1,
            output_file_prefix = paste0(output_file_prefix, "_fit_alldata"),
            stan_file = stan_file,
            chains = chains,
            parallel_chains = parallel_chains,
            threads_per_chain = 1L,
            iter_warmup = iter_warmup,
            iter_sampling = iter_sampling,
            seed = seed,
            with_core_analyses = with_core_analyses,
            with_additional_analyses = with_additional_analyses,
            show_messages = show_messages,
            show_exceptions = show_exceptions
        )
    } else {
        cat("ERROR: Unknown model name:", model_name, "\n")
        cat("Skipping this run.\n\n")
        next
    }
    
    cat("Model fitting complete!\n")
    cat("Output saved to:", rds_file, "\n\n")
    
    # Run garbage collection
    gc()
}

cat("\n======================================\n")
cat("All runs complete!\n")
cat("======================================\n")
